name: Build APK

on: [push, workflow_dispatch]

jobs:
  build:
    runs-on: ubuntu-latest

    env:
      GRADLE_USER_HOME: ${{ runner.temp }}/dynax-gradle-${{ github.run_id }}

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: 8.2
          cache-disabled: true

      - name: Extract project
        run: unzip -o DynamicIsland.jpg -d proj

      - name: Check Gradle environment
        run: |
          echo "GRADLE_USER_HOME=$GRADLE_USER_HOME"
          which gradle
          gradle --version

      - name: Build APK
        run: cd proj && gradle assembleDebug --no-daemon --stacktrace --info

      - uses: actions/upload-artifact@v4
        with:
          name: island-apk
          path: proj/app/build/outputs/apk/debug/app-debug.apk
